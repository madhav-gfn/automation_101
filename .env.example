# ---- Local Hasura (docker-compose) ----
HASURA_GRAPHQL_ENDPOINT=http://localhost:8080/v1/graphql
HASURA_GRAPHQL_ENDPOINT_BASE=http://localhost:8080
HASURA_GRAPHQL_ADMIN_SECRET=localdevsecret
HASURA_GRAPHQL_JWT_SECRET=local-dev-jwt-secret-please-change-0000000000000000

# ---- Nhost Cloud project (fill in once created) ----
NHOST_SUBDOMAIN=
NHOST_REGION=
NHOST_ADMIN_SECRET=

# ---- LLM provider (llm_call step) ----
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- notify step stub target (e.g. a webhook.site URL, or leave blank to just log) ----
NOTIFY_WEBHOOK_URL=

# ---- Action handler function base URL (local: functions dev server) ----
# Hasura runs in Docker, so it must reach the functions dev server via the Docker
# host gateway, not "localhost" (which inside the container means the container itself).
ACTIONS_BASE_URL=http://host.docker.internal:3010
ACTIONS_BASE_URL_EVENT_DB=http://host.docker.internal:3010/events/on-external-event
ACTIONS_BASE_URL_EVENT_NOTIFY=http://host.docker.internal:3010/events/on-notify-step
ACTIONS_WEBHOOK_SECRET=local-dev-actions-secret
EVENT_TRIGGER_SECRET=local-event-trigger-secret-change-me

# ---- functions dev server (scripts/functions-dev-server.mjs) ----
FUNCTIONS_PORT=3010
